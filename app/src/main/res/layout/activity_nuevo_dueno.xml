<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    tools:ignore="Overdraw">

    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circular_white"
        android:clickable="true"
        android:contentDescription="@string/volver_atras"
        android:elevation="2dp"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@color/brand_navy" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/headerTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/toolbar"
        app:layout_constraintTop_toTopOf="@id/toolbar">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo dueño y mascota"
            android:textColor="@color/brand_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargalos acá, sin necesidad de dar un turno"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barreraHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="toolbar,headerTexto" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/barraCrear"
        app:layout_constraintTop_toBottomOf="@id/barreraHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Dueño -->
            <TextView
                style="@style/EventoSeccion"
                android:text="Dueño" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lblDuenoNombre"
                    style="@style/VetFormLabel"
                    android:layout_marginTop="0dp"
                    android:text="Nombre y apellido *" />

                <EditText
                    android:id="@+id/etDuenoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field_card"
                    android:hint="Nombre y apellido del dueño"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lblDuenoDni"
                    style="@style/VetFormLabel"
                    android:text="DNI *" />

                <EditText
                    android:id="@+id/etDuenoDni"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field_card"
                    android:hint="Sin puntos"
                    android:inputType="number"
                    android:maxLength="8"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lblDuenoTelefono"
                    style="@style/VetFormLabel"
                    android:text="Teléfono (WhatsApp) *" />

                <EditText
                    android:id="@+id/etDuenoTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field_card"
                    android:hint="Ej: 11 2345 6789"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lblDuenoEmail"
                    style="@style/VetFormLabel"
                    android:text="Correo *" />

                <EditText
                    android:id="@+id/etDuenoEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field_card"
                    android:hint="Con este correo ingresa a la app"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Mascota nueva -->
            <LinearLayout
                android:id="@+id/bloqueMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/EventoSeccion"
                    android:layout_marginTop="22dp"
                    android:text="Mascota" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/VetFormLabel"
                        android:layout_marginTop="0dp"
                        android:text="Nombre *" />

                    <EditText
                        android:id="@+id/etMascotaNombre"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field_card"
                        android:hint="Nombre de la mascota"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/brand_navy"
                        android:textColorHint="@color/text_gray"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field_card">

                            <Spinner
                                android:id="@+id/spMascotaTipo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field_card">

                            <Spinner
                                android:id="@+id/spMascotaSexo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etMascotaRaza"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field_card"
                        android:hint="Raza (ej: Golden Retriever)"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/brand_navy"
                        android:textColorHint="@color/text_gray"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mascotas ya cargadas que pasan al dueño -->
            <TextView
                android:id="@+id/tvMascotasVinculadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="@color/brand_navy"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Con o sin cuenta -->
            <LinearLayout
                android:id="@+id/bloqueCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Crear cuenta para el dueño"
                        android:textColor="@color/brand_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swCrearCuenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAyudaCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/barraCrear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/login_bg"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrear"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/primary_teal"
            android:text="Crear cuenta y mascota"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
