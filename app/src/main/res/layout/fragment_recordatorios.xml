<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRecordatorios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="16dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/btnEditarEvento"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_recordatorio" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:backgroundTint="@color/primary_teal"
        android:src="@drawable/ic_plus"
        app:layout_constraintBottom_toTopOf="@id/btnEditarEvento"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white"
        app:shapeAppearanceOverlay="@style/CircleImage"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarEvento"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:padding="12dp"
        android:text="Editar evento"
        android:textAllCaps="false"
        android:textColor="@color/primary_teal"
        app:strokeColor="@color/primary_teal"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>