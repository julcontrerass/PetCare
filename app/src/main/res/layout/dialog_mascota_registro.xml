<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvTituloMascota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="Nueva mascota"
        android:textColor="@color/brand_navy"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMascotaFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/light_teal"
                    android:contentDescription="Foto de la mascota"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_dog"
                    app:contentPadding="24dp"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:tint="@color/teal_dark" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMascotaFoto"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/primary_teal"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cambiar_foto_perfil_desc"
                        android:src="@drawable/ic_pencil"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                style="@style/VetFormLabel"
                android:text="Nombre" />

            <EditText
                android:id="@+id/etMascotaNombre"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Ej: Koda"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:text="Tipo de mascota" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgMascotaTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true" />

            <TextView
                style="@style/VetFormLabel"
                android:text="Sexo" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgMascotaSexo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true" />

            <TextView
                style="@style/VetFormLabel"
                android:text="Raza (opcional)" />

            <EditText
                android:id="@+id/etMascotaRaza"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Ej: Golden Retriever"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:text="Fecha de nacimiento (opcional)" />

            <EditText
                android:id="@+id/etMascotaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:focusable="false"
                android:hint="Elegir fecha"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/EventoSeccion"
                android:layout_marginTop="20dp"
                android:text="Más datos (opcional)"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/VetFormLabel"
                        android:text="Peso (kg)" />

                    <EditText
                        android:id="@+id/etMascotaPeso"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_card"
                        android:hint="Ej: 12.5"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/brand_navy"
                        android:textColorHint="@color/text_gray"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/VetFormLabel"
                        android:text="Color" />

                    <EditText
                        android:id="@+id/etMascotaColor"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_card"
                        android:hint="Ej: Dorado"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/brand_navy"
                        android:textColorHint="@color/text_gray"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/VetFormLabel"
                android:text="Microchip" />

            <EditText
                android:id="@+id/etMascotaMicrochip"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="15 dígitos"
                android:inputType="number"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:text="Observaciones" />

            <EditText
                android:id="@+id/etMascotaObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field_card"
                android:gravity="top"
                android:hint="Alergias, medicación, cuidados especiales..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMascotaCancelar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="@color/text_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMascotaGuardar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar mascota"
            android:textColor="@color/primary_teal"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
