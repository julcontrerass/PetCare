<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar medicamento"
            android:textColor="@color/brand_navy"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Si indicás cada cuántas horas y por cuántos días, el dueño recibe el recordatorio de cada toma."
            android:textColor="@color/text_gray"
            android:textSize="13.5sp" />

        <EditText
            android:id="@+id/etMedicamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field_card"
            android:hint="Medicamento (ej: Amoxicilina)"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="@color/brand_navy"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etDosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field_card"
            android:hint="Dosis (ej: 250 mg, 1 comprimido)"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="@color/brand_navy"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCadaHoras"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_field_card"
                android:hint="Cada (horas)"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etDias"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field_card"
                android:hint="Durante (días)"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etIndicacionesMedicamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field_card"
            android:gravity="top"
            android:hint="Indicaciones (con comida, en ayunas, vía...)"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="@color/brand_navy"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarMedicamento"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Agregar a la receta"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_teal"
            app:cornerRadius="25dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarMedicamento"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/brand_navy"
            app:cornerRadius="25dp"
            app:strokeColor="@color/login_field_stroke" />
    </LinearLayout>
</ScrollView>
