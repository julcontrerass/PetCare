<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp">

        <TextView
            style="@style/EventoSeccion"
            android:layout_marginBottom="10dp"
            android:text="Datos clínicos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_weight"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Peso" />

                    <TextView
                        android:id="@+id/tvPeso"
                        style="@style/PetInfoValue"
                        android:text="4.5 kg" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chip"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Microchip" />

                    <TextView
                        android:id="@+id/tvMicrochip"
                        style="@style/PetInfoValue"
                        android:text="981020000123456" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dog"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Color" />

                    <TextView
                        android:id="@+id/tvColor"
                        style="@style/PetInfoValue"
                        android:text="Marrón y Negro" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_document"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Observaciones" />

                    <TextView
                        android:id="@+id/tvObservaciones"
                        style="@style/PetInfoValue"
                        android:text="Sensibilidad a ciertos tipos de arena para gatos." />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/EventoSeccion"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:text="Propietario" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Nombre completo" />

                    <TextView
                        android:id="@+id/tvPropNombre"
                        style="@style/PetInfoValue"
                        android:text="María Fernández" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Dirección" />

                    <TextView
                        android:id="@+id/tvPropDireccion"
                        style="@style/PetInfoValue"
                        android:text="Av. Santa Fe 1234, CABA" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Teléfono de contacto" />

                    <TextView
                        android:id="@+id/tvPropTelefono"
                        style="@style/PetInfoValue"
                        android:text="+54 11 4444-5555" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mail"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Email" />

                    <TextView
                        android:id="@+id/tvPropEmail"
                        style="@style/PetInfoValue"
                        android:text="m.fernandez@email.com" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
