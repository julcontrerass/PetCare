<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    tools:ignore="Overdraw">

    <!-- Header -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circular_white"
        android:clickable="true"
        android:contentDescription="@string/volver_atras"
        android:elevation="2dp"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@color/brand_navy" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo evento"
            android:textColor="@color/brand_navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Stepper -->
    <LinearLayout
        android:id="@+id/stepperRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="22dp"
        android:gravity="top"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/step1Circle"
                style="@style/StepCircle" />

            <TextView
                android:id="@+id/step1Label"
                style="@style/StepLabel"
                android:text="Tipo" />
        </LinearLayout>

        <View
            android:id="@+id/line1"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="#E6EAE9" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/step2Circle"
                style="@style/StepCircle" />

            <TextView
                android:id="@+id/step2Label"
                style="@style/StepLabel"
                android:text="Detalles" />
        </LinearLayout>

        <View
            android:id="@+id/line2"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="#E6EAE9" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/step3Circle"
                style="@style/StepCircle" />

            <TextView
                android:id="@+id/step3Label"
                style="@style/StepLabel"
                android:text="Resumen" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/stepperRow">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- PASO 1: TIPO Y MASCOTA -->
            <LinearLayout
                android:id="@+id/step1Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/EventoSeccion"
                    android:text="¿Qué servicio o especialidad necesitás?" />

                <EditText
                    android:id="@+id/etBuscarServicio"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_field_card"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/text_gray"
                    android:hint="Buscar servicio o especialidad"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:id="@+id/llServiciosEvento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/EventoSeccion"
                    android:layout_marginTop="26dp"
                    android:text="¿Para quién es?" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingVertical="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llMascotasEvento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- PASO 2: DETALLES -->
            <LinearLayout
                android:id="@+id/step2Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTurnoActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_info_banner"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:textColor="@color/teal_dark"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVeterinarioLabel"
                    style="@style/EventoSeccion"
                    android:text="Veterinario" />

                <LinearLayout
                    android:id="@+id/veterinarioOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvSinVeterinarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field_card"
                    android:padding="16dp"
                    android:text="No hay veterinarios disponibles para esta categoría"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/EventoSeccion"
                    android:layout_marginTop="22dp"
                    android:text="Fecha" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/btnMesAnteriorMini"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_light_teal"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_left"
                                app:tint="@color/primary_teal" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvMesAnoMini"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="@color/brand_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/btnMesSiguienteMini"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_light_teal"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/primary_teal" />
                        </FrameLayout>
                    </LinearLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:columnCount="7">

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:text="L" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:text="M" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:text="M" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:text="J" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:text="V" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:text="S" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:text="D" />
                    </GridLayout>

                    <GridLayout
                        android:id="@+id/gridCalendarioMini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7" />
                </LinearLayout>

                <TextView
                    style="@style/EventoSeccion"
                    android:layout_marginTop="22dp"
                    android:text="Hora" />

                <GridLayout
                    android:id="@+id/gridHoras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="3" />

                <TextView
                    android:id="@+id/tvSinHoras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/EventoSeccion"
                    android:layout_marginTop="22dp"
                    android:text="Observaciones (opcional)" />

                <EditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field_card"
                    android:gravity="top"
                    android:hint="Ej: llevar el carnet de vacunación"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="92dp"
                    android:padding="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- PASO 3: RESUMEN -->
            <LinearLayout
                android:id="@+id/step3Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/EventoSeccion"
                    android:text="Revisá los datos del turno" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_hero_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvResumenCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvResumenMascota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textColor="#F2FFFFFF"
                        android:textSize="15sp"
                        app:drawableStartCompat="@drawable/ic_dog"
                        app:drawableTint="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvResumenFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_glass"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_calendar"
                            app:drawableTint="@color/white" />

                        <TextView
                            android:id="@+id/tvResumenHora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_glass"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_clock"
                            app:drawableTint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp">

                    <LinearLayout style="@style/PetInfoRow">

                        <FrameLayout style="@style/PetInfoIconBox">

                            <ImageView
                                style="@style/PetStatIcon"
                                android:src="@drawable/ic_medical_kit" />
                        </FrameLayout>

                        <LinearLayout style="@style/PetInfoTexts">

                            <TextView
                                style="@style/PetInfoLabel"
                                android:text="Veterinario" />

                            <TextView
                                android:id="@+id/tvResumenVeterinario"
                                style="@style/PetInfoValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/PetInfoDivider" />

                    <LinearLayout style="@style/PetInfoRow">

                        <FrameLayout style="@style/PetInfoIconBox">

                            <ImageView
                                style="@style/PetStatIcon"
                                android:src="@drawable/ic_document" />
                        </FrameLayout>

                        <LinearLayout style="@style/PetInfoTexts">

                            <TextView
                                style="@style/PetInfoLabel"
                                android:text="Observaciones" />

                            <TextView
                                android:id="@+id/tvResumenObservaciones"
                                style="@style/PetInfoValue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/EventoSeccion"
                    android:layout_marginTop="22dp"
                    android:text="Estudios previos (opcional)" />

                <LinearLayout
                    android:id="@+id/llEstudiosTurno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvSinEstudios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:text="Si para este turno hace falta un estudio anterior, adjuntalo y el veterinario lo va a ver."
                        android:textColor="@color/text_gray"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirEstudio"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Elegir uno cargado"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_teal"
                        android:textSize="13.5sp"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/primary_teal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubirEstudio"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Subir uno nuevo"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_teal"
                        android:textSize="13.5sp"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/primary_teal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_info_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/primary_teal" />

                    <TextView
                        android:id="@+id/tvNotaAcceso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/teal_dark"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_bar"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnAtrasCancelar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_cancelar"
            android:textColor="@color/primary_teal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSiguienteGuardar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_pill_teal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_siguiente"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
