<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    tools:ignore="Overdraw">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvVetProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/ivVetHomeFoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/juani" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Hola"
                        android:textColor="@color/brand_navy"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVetDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivNotifications"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/circular_white"
                    android:clickable="true"
                    android:contentDescription="@string/notificaciones_desc"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/brand_navy" />
            </LinearLayout>

            <!-- Próxima consulta -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_hero_card"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="-16dp"
                    android:layout_marginBottom="-24dp"
                    android:alpha="0.13"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="-10"
                    android:src="@drawable/ic_dog"
                    app:tint="@color/white" />

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_hero_icon">

                    <ImageView
                        android:id="@+id/ivHeroIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvHeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="Próxima consulta"
                        android:textAllCaps="true"
                        android:textColor="#D9FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="60dp"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="40dp"
                        android:textColor="#EBFFFFFF"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/btnHeroAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="9dp"
                        android:textColor="@color/primary_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Resumen del día -->
            <LinearLayout
                android:id="@+id/llSummaryCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-5dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/PetStatCard">

                    <FrameLayout style="@style/PetStatIconBox">

                        <ImageView
                            style="@style/PetStatIcon"
                            android:src="@drawable/ic_dog" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvPacientesHoy"
                        style="@style/PetStatValue" />

                    <TextView
                        style="@style/PetStatLabel"
                        android:text="Pacientes hoy" />
                </LinearLayout>

                <LinearLayout style="@style/PetStatCard">

                    <FrameLayout
                        style="@style/PetStatIconBox"
                        android:backgroundTint="@color/light_orange">

                        <ImageView
                            style="@style/PetStatIcon"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/accent_orange" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvConsultasPendientes"
                        style="@style/PetStatValue" />

                    <TextView
                        style="@style/PetStatLabel"
                        android:text="Pendientes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileSolicitudes"
                    style="@style/PetStatCard"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        style="@style/PetStatIconBox"
                        android:backgroundTint="@color/light_purple">

                        <ImageView
                            style="@style/PetStatIcon"
                            android:src="@drawable/ic_key"
                            android:tint="@color/accent_purple" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSolicitudesPend"
                        style="@style/PetStatValue" />

                    <TextView
                        style="@style/PetStatLabel"
                        android:text="Solicitudes" />
                </LinearLayout>
            </LinearLayout>

            <!-- Consultas de hoy -->
            <LinearLayout
                android:id="@+id/llConsultasHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Consultas de hoy"
                    android:textColor="@color/brand_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVerAgenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:text="Ver agenda"
                    android:textColor="@color/primary_teal"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConsultas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_vet" />

            <include
                android:id="@+id/emptyConsultas"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/vet_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
