<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRegVet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    tools:ignore="Overdraw">

    <FrameLayout
        android:id="@+id/btnBackRegVet"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circular_white"
        android:clickable="true"
        android:contentDescription="@string/volver_atras"
        android:elevation="2dp"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@color/brand_navy" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/btnBackRegVet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBackRegVet"
        app:layout_constraintTop_toTopOf="@id/btnBackRegVet">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuenta profesional"
            android:textColor="@color/brand_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPasoActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llProgreso"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginHorizontal="17dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnBackRegVet" />

    <ScrollView
        android:id="@+id/scrollPasos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/barraPasos"
        app:layout_constraintTop_toBottomOf="@id/llProgreso">

        <LinearLayout
            android:id="@+id/contenedorPasos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/paso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Contanos quién sos"
                android:textColor="@color/brand_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estos datos identifican tu perfil profesional."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivRegFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/light_teal"
                    android:contentDescription="Foto de perfil"
                    android:scaleType="centerInside"
                    app:contentPadding="30dp"
                    android:src="@drawable/ic_person"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3dp"
                    app:tint="@color/teal_dark" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnRegFoto"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/primary_teal"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cambiar_foto_perfil_desc"
                        android:src="@drawable/ic_pencil"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Foto de perfil (opcional)"
                android:textColor="@color/text_gray"
                android:textSize="12.5sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="18dp"
                android:text="Cómo querés que te llamemos" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="14dp"
                android:text="Nombre y apellido" />

            <EditText
                android:id="@+id/etVetNombre"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Ej: Ana Gómez"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="14dp"
                android:text="DNI" />

            <EditText
                android:id="@+id/etVetDni"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Sin puntos"
                android:inputType="number"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="14dp"
                android:text="Teléfono de contacto" />

            <EditText
                android:id="@+id/etVetTelefono"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Ej: 11 4000-1234"
                android:inputType="phone"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/paso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_medical"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tu práctica profesional"
                android:textColor="@color/brand_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Los dueños van a ver estos datos al buscarte."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="22dp"
                android:text="Matrícula profesional" />

            <EditText
                android:id="@+id/etVetMatricula"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Ej: MP-12345"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="14dp"
                android:text="Veterinaria o clínica donde atendés" />

            <EditText
                android:id="@+id/etVetClinica"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Ej: Clínica Veterinaria Central"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="14dp"
                android:text="Dirección de la veterinaria" />

            <EditText
                android:id="@+id/etVetDireccion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Calle, número y ciudad"
                android:inputType="textPostalAddress|textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/paso3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_syringe"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tus especialidades"
                android:textColor="@color/brand_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Elegí todas las prácticas que realizás."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEspCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/teal_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgEspecialidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <TextView
                android:id="@+id/tvEspError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Elegí al menos una especialidad"
                android:textColor="@color/danger_red"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/paso4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tu horario de atención"
                android:textColor="@color/brand_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Los turnos solo se van a poder agendar en estos días y horarios."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="22dp"
                android:text="Días que atendés" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPresetLV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="Lunes a viernes"
                    android:textColor="@color/primary_teal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPresetLS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="Lunes a sábado"
                    android:textColor="@color/primary_teal"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/VetFormLabel"
                        android:text="Desde" />

                    <EditText
                        android:id="@+id/etVetApertura"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_card"
                        android:focusable="false"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/brand_navy"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/VetFormLabel"
                        android:text="Hasta" />

                    <EditText
                        android:id="@+id/etVetCierre"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_card"
                        android:focusable="false"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/brand_navy"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvResumenHorarioReg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_banner"
                android:padding="14dp"
                android:textColor="@color/teal_dark"
                android:textSize="13.5sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/paso5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Creá tu cuenta"
                android:textColor="@color/brand_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Con estos datos vas a iniciar sesión."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="22dp"
                android:text="Correo electrónico" />

            <EditText
                android:id="@+id/etVetEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="nombre@correo.com"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="14dp"
                android:text="Contraseña" />

            <EditText
                android:id="@+id/etVetPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Mínimo 6 caracteres"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                style="@style/VetFormLabel"
                android:layout_marginTop="14dp"
                android:text="Confirmar contraseña" />

            <EditText
                android:id="@+id/etVetPassword2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_card"
                android:hint="Repetí la contraseña"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvResumenCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="@color/brand_navy"
                android:textSize="13.5sp" />

            <CheckBox
                android:id="@+id/cbVetTerminos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/primary_teal"
                android:text="Acepto los términos y condiciones" />

        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraPasos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_bar"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPasoAtras"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Atrás"
            android:textAllCaps="false"
            android:textColor="@color/primary_teal"
            android:textSize="16sp"
            app:cornerRadius="27dp"
            app:strokeColor="@color/primary_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPasoSiguiente"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="2"
            android:backgroundTint="@color/primary_teal"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
