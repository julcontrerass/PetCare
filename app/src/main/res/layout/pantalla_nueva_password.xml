<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nuevaPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Elegí tu nueva contraseña"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Confirmamos tu correo. Escribí la contraseña que vas a usar de ahora en más."
        android:textColor="@color/text_gray" />

    <EditText
        android:id="@+id/etNuevaPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:autofillHints="newPassword"
        android:background="@drawable/bg_edit_text"
        android:hint="Nueva contraseña"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp" />

    <EditText
        android:id="@+id/etNuevaPassword2"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:autofillHints="newPassword"
        android:background="@drawable/bg_edit_text"
        android:hint="Repetí la contraseña"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarNuevaPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/primary_teal"
        android:text="Guardar y entrar"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="8dp" />
</LinearLayout>
