<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAdmin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    tools:ignore="Overdraw">

    <FrameLayout
        android:id="@+id/panelesAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:id="@+id/panelInicio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Panel de control"
                            android:textColor="@color/brand_navy"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAdminFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnAdminCuenta"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/circular_white"
                        android:clickable="true"
                        android:contentDescription="Cuenta de administrador"
                        android:elevation="2dp"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_person"
                            app:tint="@color/brand_navy" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/heroAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_hero_admin"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvAdminHeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdminHeroTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdminHeroSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnAdminHeroAccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_pill_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingHorizontal="22dp"
                        android:paddingVertical="11dp"
                        android:textColor="@color/brand_navy"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileAdminVets"
                    style="@style/PetStatCard"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="6dp">

                    <FrameLayout
                        style="@style/PetStatIconBox"
                        android:backgroundTint="@color/light_green">

                        <ImageView
                            style="@style/PetStatIcon"
                            android:src="@drawable/ic_medical_kit"
                            app:tint="@color/success_green" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatVets"
                        style="@style/PetStatValue"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/PetStatLabel"
                        android:text="Veterinarios activos" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileAdminDuenos"
                    style="@style/PetStatCard"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="0dp">

                    <FrameLayout
                        style="@style/PetStatIconBox"
                        android:backgroundTint="@color/light_teal">

                        <ImageView
                            style="@style/PetStatIcon"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary_teal" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatDuenos"
                        style="@style/PetStatValue"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/PetStatLabel"
                        android:text="Dueños" />
                </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileAdminMascotas"
                    style="@style/PetStatCard"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="6dp">

                    <FrameLayout
                        style="@style/PetStatIconBox"
                        android:backgroundTint="@color/light_purple">

                        <ImageView
                            style="@style/PetStatIcon"
                            android:src="@drawable/ic_dog"
                            app:tint="@color/accent_purple" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatMascotas"
                        style="@style/PetStatValue"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/PetStatLabel"
                        android:text="Mascotas" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileAdminTurnos"
                    style="@style/PetStatCard"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="0dp">

                    <FrameLayout
                        style="@style/PetStatIconBox"
                        android:backgroundTint="@color/light_orange">

                        <ImageView
                            style="@style/PetStatIcon"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/accent_orange" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatTurnos"
                        style="@style/PetStatValue"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/PetStatLabel"
                        android:text="Turnos de hoy" />
                </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/EventoSeccion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Para revisar" />

                    <TextView
                        android:id="@+id/btnVerTodasPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="Ver todas"
                        android:textColor="@color/primary_teal"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPendientesInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <include
                    android:id="@+id/emptyPendientesInicio"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/EventoSeccion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Actividad reciente" />

                    <TextView
                        android:id="@+id/btnVerActividad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="Ver todo"
                        android:textColor="@color/primary_teal"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llActividadInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/panelVets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvVetsTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Veterinarios"
                android:textColor="@color/brand_navy"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVetsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_gray" />

                <EditText
                    android:id="@+id/etBuscarVetAdmin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar por nombre, matrícula o clínica..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="15sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgFiltroVets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVetsAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <include
                    android:id="@+id/emptyVetsAdmin"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelDuenos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDuenosTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dueños"
                android:textColor="@color/brand_navy"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDuenosCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_gray" />

                <EditText
                    android:id="@+id/etBuscarDuenoAdmin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar por nombre, DNI o correo..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="15sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgFiltroDuenos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDuenosAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <include
                    android:id="@+id/emptyDuenosAdmin"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelActividad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvActividadTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actividad"
                android:textColor="@color/brand_navy"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActividadCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActividadAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <include
                    android:id="@+id/emptyActividadAdmin"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <include
        layout="@layout/admin_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
