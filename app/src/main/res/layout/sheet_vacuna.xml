<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar vacuna aplicada"
            android:textColor="@color/brand_navy"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVacunaPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_gray"
            android:textSize="13.5sp" />

        <AutoCompleteTextView
            android:id="@+id/etVacunaNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field_card"
            android:completionThreshold="0"
            android:hint="Vacuna (ej: Antirrábica)"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="@color/brand_navy"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etVacunaMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field_card"
            android:hint="Marca / producto (opcional)"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="@color/brand_navy"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etVacunaLote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_field_card"
                android:hint="Lote (opcional)"
                android:inputType="textCapCharacters"
                android:padding="12dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etVacunaVenceLote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field_card"
                android:clickable="true"
                android:focusable="false"
                android:hint="Vence el lote"
                android:padding="12dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etVacunaProximaDosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field_card"
            android:clickable="true"
            android:focusable="false"
            android:hint="Próxima dosis (el dueño recibe el aviso)"
            android:padding="12dp"
            android:textColor="@color/brand_navy"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarVacuna"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Guardar en el carnet"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_teal"
            app:cornerRadius="25dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarVacuna"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/brand_navy"
            app:cornerRadius="25dp"
            app:strokeColor="@color/login_field_stroke" />
    </LinearLayout>
</ScrollView>
