<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    tools:ignore="Overdraw">

    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circular_white"
        android:clickable="true"
        android:contentDescription="@string/volver_atras"
        android:elevation="2dp"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@color/brand_navy" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editar_perfil_title"
            android:textColor="@color/brand_navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizá tus datos de contacto"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/PetInfoLabel"
                android:text="@string/label_nombre_completo"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/CampoPerfil"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoPerfilIcono"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etNombreCompleto"
                    style="@style/CampoPerfilTexto"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <TextView
                style="@style/PetInfoLabel"
                android:layout_marginTop="16dp"
                android:text="Correo electrónico"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/CampoPerfil"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoPerfilIcono"
                    android:src="@drawable/ic_mail" />

                <EditText
                    android:id="@+id/etCorreo"
                    style="@style/CampoPerfilTexto"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress" />
            </LinearLayout>

            <TextView
                style="@style/PetInfoLabel"
                android:layout_marginTop="16dp"
                android:text="Teléfono"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/CampoPerfil"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoPerfilIcono"
                    android:src="@drawable/ic_phone" />

                <EditText
                    android:id="@+id/etTelefono"
                    style="@style/CampoPerfilTexto"
                    android:autofillHints="phone"
                    android:inputType="phone" />
            </LinearLayout>

            <TextView
                style="@style/PetInfoLabel"
                android:layout_marginTop="16dp"
                android:text="Dirección"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/CampoPerfil"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoPerfilIcono"
                    android:src="@drawable/ic_location" />

                <EditText
                    android:id="@+id/etDireccion"
                    style="@style/CampoPerfilTexto"
                    android:autofillHints="postalAddress"
                    android:inputType="textPostalAddress|textCapSentences" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_bar"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_pill_teal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_guardar_perfil"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
