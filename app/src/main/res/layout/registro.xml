<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registroRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBackRegistro"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/baseline_arrow_back_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegí cómo vas a usar PetCare"
            android:textColor="@color/text_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@color/light_gray"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegRoleDueno"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_teal"
                android:text="@string/rol_dueno"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegRoleVet"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/light_gray"
                android:text="@string/rol_veterinario"
                android:textAllCaps="false"
                android:textColor="@color/text_gray"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <TextView style="@style/VetFormLabel" android:text="Nombre completo" />
        <EditText
            android:id="@+id/etRegNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints="name"
            android:background="@drawable/bg_edit_text"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp" />

        <TextView style="@style/VetFormLabel" android:text="Correo electrónico" />
        <EditText
            android:id="@+id/etRegEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_edit_text"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp" />

        <LinearLayout
            android:id="@+id/llMatricula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/VetFormLabel" android:text="Matrícula profesional" />
            <EditText
                android:id="@+id/etRegMatricula"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_edit_text"
                android:inputType="text"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <TextView style="@style/VetFormLabel" android:text="Contraseña" />
        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_edit_text"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp" />

        <TextView style="@style/VetFormLabel" android:text="Confirmar contraseña" />
        <EditText
            android:id="@+id/etRegPassword2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_edit_text"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp" />

        <CheckBox
            android:id="@+id/cbTerminos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Acepto los términos y condiciones" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary_teal"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
