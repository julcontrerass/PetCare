<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:id="@+id/cartelIconoFondo"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_icon_red">

        <ImageView
            android:id="@+id/cartelIcono"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning" />
    </FrameLayout>

    <TextView
        android:id="@+id/cartelTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/brand_navy"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cartelMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/text_gray"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCartelCancelar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:textColor="@color/brand_navy"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="25dp"
            app:strokeColor="@color/login_field_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCartelAceptar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:cornerRadius="25dp" />
    </LinearLayout>
</LinearLayout>
