<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    tools:ignore="Overdraw">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil profesional"
                android:textColor="@color/brand_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/heroPerfilVet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hero_card"
                android:elevation="3dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivVetProfilePic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/juani"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="@color/white"
                        app:strokeWidth="3dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnEditVetProfilePic"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom|end"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="2dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cambiar_foto_perfil_desc"
                            android:src="@drawable/ic_pencil"
                            app:tint="@color/teal_dark" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNombreVet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Dr. Juan Pérez"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDatosVet"
                    style="@style/HomePetChip"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_glass"
                    android:paddingVertical="4dp"
                    android:text="Matrícula MP-12345"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                style="@style/EventoSeccion"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Veterinaria y contacto" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/llVetDni"
            style="@style/PetInfoRow">

            <FrameLayout style="@style/PetInfoIconBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <LinearLayout style="@style/PetInfoTexts">

                <TextView
                    style="@style/PetInfoLabel"
                    android:text="DNI" />

                <TextView
                    android:id="@+id/tvVetDniValue"
                    style="@style/PetInfoValue"
                    android:text="30123456" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/llVetClinica"
            style="@style/PetInfoRow">

            <FrameLayout style="@style/PetInfoIconBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_medical"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <LinearLayout style="@style/PetInfoTexts">

                <TextView
                    style="@style/PetInfoLabel"
                    android:text="Clínica" />

                <TextView
                    android:id="@+id/tvVetClinicaValue"
                    style="@style/PetInfoValue"
                    android:text="Clínica Veterinaria Central" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/llVetDireccion"
            style="@style/PetInfoRow">

            <FrameLayout style="@style/PetInfoIconBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <LinearLayout style="@style/PetInfoTexts">

                <TextView
                    style="@style/PetInfoLabel"
                    android:text="Dirección" />

                <TextView
                    android:id="@+id/tvVetDireccionValue"
                    style="@style/PetInfoValue"
                    android:text="Av. Santa Fe 2345, CABA" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/llVetPhone"
            style="@style/PetInfoRow">

            <FrameLayout style="@style/PetInfoIconBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <LinearLayout style="@style/PetInfoTexts">

                <TextView
                    style="@style/PetInfoLabel"
                    android:text="Teléfono" />

                <TextView
                    android:id="@+id/tvVetPhoneValue"
                    style="@style/PetInfoValue"
                    android:text="+54 11 4000-1234" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/llVetEmail"
            style="@style/PetInfoRow">

            <FrameLayout style="@style/PetInfoIconBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <LinearLayout style="@style/PetInfoTexts">

                <TextView
                    style="@style/PetInfoLabel"
                    android:text="Correo electrónico" />

                <TextView
                    android:id="@+id/tvVetEmailValue"
                    style="@style/PetInfoValue"
                    android:text="juan.perez@clinica.com" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

            <TextView
                style="@style/EventoSeccion"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Disponibilidad y especialidades" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/llVetHorarios"
            style="@style/PetInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout style="@style/PetInfoIconBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <LinearLayout style="@style/PetInfoTexts">

                <TextView
                    style="@style/PetInfoLabel"
                    android:text="Días y horarios de atención" />

                <TextView
                    android:id="@+id/tvVetHorariosValue"
                    style="@style/PetInfoValue"
                    android:text="Lun a Vie: 09:00 - 18:00 hs · Sáb: 09:00 - 13:00 hs" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray" />

        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/llVetEspecialidades"
            style="@style/PetInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout style="@style/PetInfoIconBox">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pencil"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <LinearLayout style="@style/PetInfoTexts">

                <TextView
                    style="@style/PetInfoLabel"
                    android:text="Especialidades" />

                <TextView
                    android:id="@+id/tvVetEspecialidadesValue"
                    style="@style/PetInfoValue"
                    android:text="Cirugía Veterinaria, Dermatología, Odontología" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray" />

        </LinearLayout>

        </LinearLayout>

            <TextView
                style="@style/EventoSeccion"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Cuenta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/optEditarPerfil"
            style="@style/PetInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                style="@style/PetInfoIconBox"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pencil"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_medium"
                android:text="Editar perfil profesional"
                android:textColor="@color/brand_navy"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray" />
        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/optCambiarPassword"
            style="@style/PetInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                style="@style/PetInfoIconBox"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_key"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_medium"
                android:text="Cambiar contraseña"
                android:textColor="@color/brand_navy"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray" />
        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/optNotificaciones"
            style="@style/PetInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                style="@style/PetInfoIconBox"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/teal_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_medium"
                android:text="Notificaciones"
                android:textColor="@color/brand_navy"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray" />
        </LinearLayout>

        <View style="@style/PetInfoDivider" />

        <LinearLayout
            android:id="@+id/optCerrarSesion"
            style="@style/PetInfoRow"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                style="@style/PetInfoIconBox"
                android:background="@drawable/bg_chip_danger">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/danger_red" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_medium"
                android:text="Cerrar sesión"
                android:textColor="@color/danger_red"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray" />
        </LinearLayout>

        </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/vet_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
