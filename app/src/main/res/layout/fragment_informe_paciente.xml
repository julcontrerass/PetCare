<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp">

        <TextView
            style="@style/EventoSeccion"
            android:text="Informe de consulta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motivo del turno / consulta"
                android:textColor="@color/text_gray"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/etMotivoConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field_card"
                android:hint="Ej: Vacuna anual, Control general"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Diagnóstico y observaciones clínicas"
                android:textColor="@color/text_gray"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/etDiagnostico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field_card"
                android:gravity="top"
                android:hint="Escribir informe clínico, diagnóstico, examen físico..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:padding="12dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Indicaciones y tratamiento"
                android:textColor="@color/text_gray"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/etTratamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field_card"
                android:gravity="top"
                android:hint="Medicamentos prescriptos, dosis, recomendaciones..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarInforme"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary_teal"
            android:text="Guardar informe"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
