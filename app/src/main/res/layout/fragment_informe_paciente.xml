<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informe de consulta"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Motivo del turno / consulta"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/text_gray" />

        <EditText
            android:id="@+id/etMotivoConsulta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Ej: Vacuna anual, Control general"
            android:padding="12dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Diagnóstico y observaciones clínicas"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/text_gray" />

        <EditText
            android:id="@+id/etDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="top"
            android:hint="Escribir informe clínico, diagnóstico, exámen físico..."
            android:inputType="textMultiLine"
            android:minLines="4"
            android:padding="12dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Indicaciones y tratamiento"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/text_gray" />

        <EditText
            android:id="@+id/etTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="top"
            android:hint="Medicamentos prescriptos, dosis, recomendaciones..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary_teal"
            android:padding="12dp"
            android:text="Guardar informe"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
