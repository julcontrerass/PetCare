<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/login_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_admin"
            android:elevation="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_chip_glass">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="AD"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Administrador"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCuentaEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />

            <TextView
                style="@style/HomePetChip"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_glass"
                android:paddingVertical="4dp"
                android:text="Acceso total"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_medical_kit"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Veterinarios" />

                    <TextView
                        android:id="@+id/tvCuentaVets"
                        style="@style/PetInfoValue" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Dueños y mascotas" />

                    <TextView
                        android:id="@+id/tvCuentaDuenos"
                        style="@style/PetInfoValue" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PetInfoDivider" />

            <LinearLayout style="@style/PetInfoRow">

                <FrameLayout style="@style/PetInfoIconBox">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/teal_dark" />
                </FrameLayout>

                <LinearLayout style="@style/PetInfoTexts">

                    <TextView
                        style="@style/PetInfoLabel"
                        android:text="Altas por revisar" />

                    <TextView
                        android:id="@+id/tvCuentaPendientes"
                        style="@style/PetInfoValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCuentaCerrarSesion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:maxLines="1"
            android:text="Cerrar sesión"
            android:textColor="@color/danger_red"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/danger_red"
            app:strokeColor="@color/danger_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCuentaVolver"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Volver"
            android:textColor="@color/text_gray"
            android:textSize="15sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
