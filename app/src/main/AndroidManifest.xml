<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PetCareApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetCare">
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.dueno.DuenoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:screenOrientation="portrait"
            android:name=".HomeVeterinarioActivity"
            android:exported="false" />
        <activity android:screenOrientation="portrait"
            android:name=".RegistroDuenoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:screenOrientation="portrait"
            android:name=".RegistroVeterinarioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:screenOrientation="portrait" android:name=".MisPacientesActivity" />
        <activity android:screenOrientation="portrait" android:name=".DetallePacienteActivity" />
        <activity android:screenOrientation="portrait" android:name=".SolicitudesVetActivity" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".AgendaVetActivity" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".PerfilVetActivity" android:exported="false" />
        <activity android:screenOrientation="portrait"
            android:name=".AgregarConsultaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:screenOrientation="portrait" android:name=".DetalleEventoVetActivity" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".CarnetSaludActivity" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".HomeAdminActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="frgp.utn.edu.petcare.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>